@startuml
!define RELATIVE_INCLUDE true
!include ../../diagrams/vendor/c4-plantuml/C4_Component.puml
LAYOUT_LEFT_RIGHT()
skinparam defaultFontName Arial
skinparam dpi 110
skinparam nodesep 35
skinparam ranksep 65
show stereotype
title AgroTech X — C3, Сервис инцидентов / вариант Б
Container_Ext(api, "Локальный API", "ASP.NET Core", "Проверенные команды дежурного")
Container_Ext(ui, "Терминал фермы", "React + Vite; .NET агент", "Тревоги от оповещения и карточки")
ContainerDb_Ext(bus, "Локальный журнал Kafka", "Apache Kafka", "Входные наблюдения / команды; факты")
ContainerDb_Ext(proj, "Локальные проекции", "PostgreSQL", "Восстанавливаемое состояние")
Container_Boundary(svc, "Сервис инцидентов — контейнер C2") {
 Component(worker, "Обработчик раздела", "C# / Kafka client", "Consumer group; один владелец раздела")
 Component(domain, "Агрегат инцидента", "C#", "Окно, подрепорты, версия, ответственный")
 Component(tx, "Транзакционная публикация", "C# / Kafka client", "Fencing старого producer; факты + offset")
 Component(project, "Проектор карточек", "C#", "Read-committed; версия и дедупликация")
}
Rel(api, bus, "Команда + expected_version, ключ зоны", "Kafka / acks=all")
Rel(bus, worker, "Команды / наблюдения", "Kafka consumer")
Rel(worker, domain, "Восстановленное состояние и вход", "In-process")
Rel(domain, tx, "Новые факты + версия", "In-process")
Rel(tx, bus, "Факты и commit позиции атомарно", "Kafka transaction")
Rel(bus, project, "Подтверждённые факты", "read_committed")
Rel(project, proj, "Версия карточки", "SQL / idempotency")
Rel(project, ui, "Канонический ID и подрепорты", "SSE / HTTPS")
legend right
|<#FFFFFF><color:#333333> Обозначения |
|<#85BBF0><color:#333333> Компонент |
|<#B3B3B3><color:white> Соседний контейнер |
endlegend
@enduml
