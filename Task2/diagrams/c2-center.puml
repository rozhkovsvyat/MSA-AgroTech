@startuml
!define RELATIVE_INCLUDE true
!include ../../diagrams/vendor/c4-plantuml/C4_Container.puml
LAYOUT_LEFT_RIGHT()
skinparam defaultFontName Arial
skinparam dpi 110
skinparam nodesep 50
skinparam ranksep 55
show stereotype
title AgroTech X — C2, центральная часть

Person(user, "Сотрудник компании", "Ответственный за показатели ферм")
System(farm, "Ферма AgroTech X", "Локальная Kafka / журнал, терминал")
System_Ext(erp, "ERP и BI компании", "1С:Агро, аналитика")
System_Ext(ui, "Кабинеты сотрудников (AS-IS)", "Существующие web / mobile-клиенты AgroTech")
System_Boundary(center, "Центр AgroTech X") {

 Container(api, "Центральный API", "C# / ASP.NET Core", "Проверка токена, прав и tenant;\nмаршрутизация к БД через библиотеку")
 Container(sync, "Шлюз синхронизации", "Kafka Connect / MirrorMaker 2; HTTPS", "Копирует факты вверх; политики и ИИ вниз;\nпринимает outbox варианта А")
 ContainerDb(kafka, "Центральная Kafka", "Apache Kafka", "Факты по клиентам и фермам")
 Container(project, "Проекции и интеграции", "C# / .NET", "Учёт, прогнозы, метрики,\nполитики и обмен с ERP")
 ContainerDb(db, "БД клиентов", "PostgreSQL", "Отдельная БД на компанию")
}
Rel_D(user, ui, "Использует", "HTTPS")
Rel_D(ui, api, "Запрос + access token", "HTTPS")
BiRel_L(sync, farm, "Факты вверх; политики вниз", "Б: Kafka / mTLS; А: HTTPS")
BiRel_R(sync, kafka, "Факты вверх; намерения вниз", "Kafka / TLS")
Rel_D(api, kafka, "Намерения и политики", "Kafka / TLS")
Rel_R(api, db, "Tenant-подключение", "SQL")
Rel_R(kafka, project, "Факты с позиции", "Kafka / TLS")
Rel_U(project, db, "Tenant-проекции", "SQL")
Rel_R(project, erp, "Справочники и агрегаты", "HTTPS / API")

legend right
|<#FFFFFF><color:#333333> Обозначения |
|<#438DD5><color:white> Контейнер AgroTech |
|<#1168BD><color:white> Другая часть AgroTech |
|<#999999><color:white> Внешняя система |
endlegend
@enduml
