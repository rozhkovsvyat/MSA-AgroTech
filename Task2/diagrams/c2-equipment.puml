@startuml
!define RELATIVE_INCLUDE true
!include ../../diagrams/vendor/c4-plantuml/C4_Container.puml
LAYOUT_LANDSCAPE()
skinparam defaultFontName Arial
skinparam dpi 110
skinparam nodesep 50
skinparam ranksep 100
show stereotype
title AgroTech X — C2, управление оборудованием / вариант Б

Person(user, "Уполномоченный сотрудник", "Сотрудник фермы с правом управления")
System_Ext(device, "Оборудование", "Корм, вода, фильтры")
System_Boundary(farm, "Локальная часть AgroTech X") {
 Container(policy, "Агент политик и медиа", "C# / .NET", "Читает локальный топик намерений;\nданные пришли через MM2")
 Container(ui, "Терминал фермы", "React + Vite; .NET агент", "Команды и фактический исход")
 Container(api, "Локальный API", "C# / ASP.NET Core", "Проверяет пользователя, ферму и права")
 Container(control, "Управление оборудованием", "C# / .NET", "Окончательный допуск, лимиты,\nсрок и неизвестный исход")
 Container(adapter, "Шлюз оборудования", "C# / SDK устройств", "Проверяет epoch и command_id;\nдедупликация и опрос исполнителя")
 ContainerDb(journal, "Доменный журнал", "Apache Kafka", "Команды, допуски, фактический результат")
 Container(account, "Учёт и метрики", "C# / .NET", "Поголовье, корма, вода,\nверсионируемые пользовательские метрики")
 ContainerDb(proj, "Локальные проекции", "PostgreSQL", "Учёт и справочники")
}
Rel_R(user, ui, "Отправляет команду", "UI")
Rel_R(ui, api, "Команда + access token", "HTTPS")
Rel_R(policy, api, "Намерение с авторством и сроком", "HTTPS / mTLS")
Rel_R(api, control, "Проверенная команда", "HTTPS")
Rel_R(control, adapter, "Разрешение, ID, срок, epoch", "HTTPS / mTLS")
Rel_R(adapter, device, "Команда / запрос результата", "Протокол поставщика")
Rel_D(control, journal, "Фиксирует допуск и исход до подтверждения UI", "Kafka / TLS")
Rel_D(adapter, journal, "Телеметрия и подтверждения", "Kafka / TLS")
Rel_D(journal, account, "Наблюдения, расход и учётные факты", "Чтение по позиции")
Rel_R(account, proj, "Обновляет представления", "SQL")
Rel_D(api, proj, "Читает состояние с отметкой свежести", "SQL")

legend right
|<#FFFFFF><color:#333333> Обозначения |
|<#08427B><color:white> Пользователь |
|<#438DD5><color:white> Контейнер |
|<#999999><color:white> Внешняя система |
endlegend
@enduml
