@startuml
!define RELATIVE_INCLUDE true
!include ../../diagrams/vendor/c4-plantuml/C4_Container.puml
LAYOUT_LEFT_RIGHT()
skinparam defaultFontName Arial
skinparam dpi 110
skinparam nodesep 50
skinparam ranksep 100
show stereotype
title AgroWatch — C2, оборудование и учёт / вариант А

Person(user, "Уполномоченный сотрудник", "Сотрудник фермы с правом управления")
System_Ext(device, "Оборудование", "Корм, вода, фильтры")
System(center, "Центр AgroWatch", "Намерения и справочники")
System_Boundary(farm, "Локальная часть AgroWatch / вариант А") {
 Container(sync, "Синхронизация", "C# / .NET Worker", "Outbox вверх, намерения и политики вниз")
 Container(ui, "Терминал фермы", "React + Vite MFE; .NET агент", "Команды и фактический исход")
 Container(app, "Приложение фермы", "C# / .NET", "Модули прав, допуска, инцидентов,\nучёта; правила состояния фильтров")
 Container(adapter, "Шлюз оборудования", "C# / SDK устройств", "Дедупликация, epoch, опрос результата")
 ContainerDb(journal, "Журнал и outbox", "PostgreSQL", "Допуски, команды, исходы и учёт")
 ContainerDb(read, "Локальные проекции", "PostgreSQL", "Учёт и справочники")
}
Rel(user, ui, "Отправляет команду", "UI")
Rel(ui, app, "Запрос + access token", "HTTPS")
BiRel(sync, center, "Факты вверх; намерения вниз", "HTTPS / mTLS")
Rel(sync, app, "Намерение с проверкой на ферме", "HTTPS / mTLS")
Rel(app, adapter, "Разрешение, command_id, epoch", "HTTPS / mTLS")
Rel(adapter, device, "Команда / запрос исхода", "Протокол поставщика")
Rel(app, journal, "Фиксирует допуск до отправки", "SQL transaction")
Rel(adapter, app, "Телеметрия и фактический исход", "HTTPS / mTLS")
Rel(app, read, "Обновляет и читает учёт", "SQL")
Rel(app, ui, "Тревога по фильтрации", "HTTPS / mTLS")
System_Ext(sound, "Локальная сигнализация", "Параллельный канал тревоги")
Rel(app, sound, "Тревога по фильтрации", "Локальный адаптер")

Rel(journal, sync, "Факты из outbox по позиции", "SQL")

legend right
|<#FFFFFF><color:#333333> Обозначения |
|<#08427B><color:white> Пользователь |
|<#438DD5><color:white> Контейнер |
|<#1168BD><color:white> Программная система |
|<#999999><color:white> Внешняя система |
endlegend
@enduml
